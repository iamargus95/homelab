#!/bin/sh
case "${SSH_ORIGINAL_COMMAND-}" in
    status) exec /usr/bin/sudo -n /usr/local/sbin/hermes-homelab status ;;
    'logs '*) printf '%s\n' "${SSH_ORIGINAL_COMMAND#logs }" | /usr/bin/sudo -n /usr/local/sbin/hermes-homelab logs ;;
    restart-jellyfin) exec /usr/bin/sudo -n /usr/local/sbin/hermes-homelab restart-jellyfin ;;
    *) echo 'Supported actions: status, logs SERVICE, restart-jellyfin' >&2; exit 64 ;;
esac
