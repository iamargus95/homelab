#!/usr/bin/python3
"""Expose bounded media server operations through a forced SSH command."""

import fcntl
import os
from pathlib import Path
import re
import subprocess
import sys
import time
from urllib.request import ProxyHandler, build_opener

STATE = Path("/var/lib/hermes-homelab")
APPROVAL = STATE / "restart-jellyfin"
DOCKER = "/usr/bin/docker"
MEDIA_SERVICES = (
    "jellyfin", "sonarr", "radarr", "lidarr", "prowlarr", "bazarr",
    "qbittorrent", "sabnzbd", "seerr", "homarr",
)
CONTAINERS = {
    **{name: ("media-stack", name) for name in MEDIA_SERVICES},
    "uptime-kuma": ("uptime-kuma", "uptime-kuma"),
    "hermes": ("hermes", "hermes"),
    "nod": ("nod", "server"),
    "arr-dashboard": ("arr-dashboard", "arr-dashboard"),
    "adguard-home": ("adguard-home", "adguard-home"),
    "speedtest-tracker": ("speedtest-tracker", "speedtest-tracker"),
    "audiobookshelf": ("audiobookshelf", "audiobookshelf"),
    "listenarr": ("listenarr", "listenarr"),
}
JOURNAL_FILTERS = {
    "ssh": ("--unit=ssh.service",),
    "docker": ("--unit=docker.service",),
    "kernel": ("--dmesg", "--priority=warning"),
}
MAX_LOG_BYTES = 24_000
URL_QUERY = re.compile(r'([-\w./:%]+)\?[^\s"\x27<>]+')
CONTROL = re.compile(r'\x1b\[[0-?]*[ -/]*[@-~]|[\x00-\x08\x0b-\x1f\x7f]')
SENSITIVE = re.compile(
    r"(?i)authorization|\bbearer\s|\b(?:cookie|set-cookie)\s*[:=]|"
    r"(?<![A-Za-z0-9])(?:api[-_ ]?key|private[-_ ]?key|password|passwd|(?:client[-_ ]?)?secret|"
    r"(?:(?:access|refresh|auth)[-_ ]?)?token)"
    r"\b.{0,12}[:=]|\b(?:xox[a-z]-|xapp-|gh[pousr]_|github_pat_|sk-)[\w-]{10,}|"
    r"-----BEGIN .*PRIVATE KEY|://[^/\s@]+:[^/\s@]+@|"
    r"(?:^|\s)[A-Za-z0-9+/]{40,}={0,2}\s*$"
)


def run(*args):
    return subprocess.check_output(args, text=True, timeout=45).strip()


def container_id(project, service):
    ids = run(
        DOCKER, "ps", "-aq",
        "--filter", f"label=com.docker.compose.project={project}",
        "--filter", f"label=com.docker.compose.service={service}",
        "--filter", "label=com.docker.compose.oneoff=False",
    ).splitlines()
    if len(ids) != 1:
        raise RuntimeError(f"Expected one {project}/{service} container, found {len(ids)}")
    return ids[0]


def jellyfin():
    return container_id(*CONTAINERS["jellyfin"])


def log_excerpt(args):
    try:
        result = subprocess.run(
            args, check=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=20,
        )
    except subprocess.SubprocessError:
        raise RuntimeError("Could not read the selected service log") from None
    raw = result.stdout
    if len(raw) > MAX_LOG_BYTES:
        raw = raw[-MAX_LOG_BYTES:].partition(b"\n")[2]
        print("[earlier output omitted]")
    # Never return a partial line from before the byte limit. Drop sensitive
    # lines instead of attempting to guess where a credential value ends.
    for line in raw.decode(errors="replace").splitlines():
        line = CONTROL.sub("", line)
        line = URL_QUERY.sub(r"\1?[redacted]", line)
        print("[sensitive log line omitted]" if SENSITIVE.search(line) else line)


def logs():
    line = sys.stdin.buffer.read(65)
    if len(line) > 64 or not line.endswith(b"\n") or line.count(b"\n") != 1:
        raise RuntimeError("Expected one diagnostic service name")
    target = line[:-1].decode("ascii", errors="replace")
    if target in CONTAINERS:
        container = container_id(*CONTAINERS[target])
        log_excerpt((DOCKER, "logs", "--since", "2h", "--tail", "120", "--timestamps", container))
    elif target in JOURNAL_FILTERS:
        log_excerpt((
            "/usr/bin/journalctl", "--since=2 hours ago", "--lines=120", "--no-pager",
            "--output=short-iso", *JOURNAL_FILTERS[target],
        ))
    else:
        raise RuntimeError("Available log targets: " + ", ".join(sorted(CONTAINERS | JOURNAL_FILTERS)))


def healthy(container):
    state = run(DOCKER, "inspect", "--format", "{{.State.Status}}", container)
    if state != "running":
        return False
    bindings = run(
        DOCKER, "inspect", "--format",
        '{{with index .NetworkSettings.Ports "8096/tcp"}}{{(index . 0).HostIp}}{{end}}',
        container,
    )
    host = "127.0.0.1" if bindings == "0.0.0.0" else bindings
    if not host:
        return False
    if ":" in host:
        host = "[::1]" if host == "::" else f"[{host}]"
    try:
        with build_opener(ProxyHandler({})).open(
            f"http://{host}:8096/health", timeout=3
        ) as response:
            return response.status == 200
    except OSError:
        return False


def main(action):
    if action == "logs":
        logs()
        return

    if action == "status":
        print(run("/usr/bin/uptime"))
        print(run("/usr/bin/free", "-h"))
        media = ("/srv/media/library",) if Path("/srv/media/library").exists() else ()
        ssd = ("/srv/ssd",) if Path("/srv/ssd").is_mount() else ()
        print(run("/usr/bin/df", "-h", "/", *media, *ssd))
        allowed = {f"{project}/{service}" for project, service in CONTAINERS.values()}
        for line in run(
            DOCKER, "ps", "-a", "--filter", "label=com.docker.compose.oneoff=False",
            "--format",
            '{{.Label "com.docker.compose.project"}}/{{.Label "com.docker.compose.service"}}\t{{.Status}}',
        ).splitlines():
            name, _, state = line.partition("\t")
            if name in allowed:
                print(f"{name}: {state}")
        try:
            jellyfin_up = healthy(jellyfin())
        except (OSError, RuntimeError, subprocess.SubprocessError):
            jellyfin_up = False
        print(f"Jellyfin HTTP health: {'ok' if jellyfin_up else 'unavailable'}")
        return

    with (STATE / "lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if action == "approve-restart-jellyfin":
            APPROVAL.touch(mode=0o600)
            print("Approved one Jellyfin restart in the next five minutes.")
            return

        if not APPROVAL.exists() or time.time() - APPROVAL.stat().st_mtime > 300:
            raise RuntimeError("No current Jellyfin restart approval. Ask the operator to approve it on the host.")
        container = jellyfin()
        APPROVAL.unlink()
        run(DOCKER, "restart", "--time", "15", container)
        deadline = time.monotonic() + 60
        while time.monotonic() < deadline:
            if healthy(container):
                print("Jellyfin restarted and returned HTTP 200 on /health.")
                return
            time.sleep(2)
        raise RuntimeError("Jellyfin restarted but its HTTP health check did not recover.")


if __name__ == "__main__":
    actions = {"status", "logs", "restart-jellyfin", "approve-restart-jellyfin"}
    if os.geteuid() != 0 or len(sys.argv) != 2 or sys.argv[1] not in actions:
        sys.exit("Run with sudo and specify one supported action.")
    try:
        main(sys.argv[1])
    except (OSError, RuntimeError, subprocess.SubprocessError) as exc:
        sys.exit(str(exc))
